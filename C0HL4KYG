}

function updateNavbar(name) {
  const container = document.getElementById('navUserContainer');
  container.innerHTML = `
    <div class="nav-user" onclick="openModal()">
      <span class="avatar">${name.charAt(0).toUpperCase()}</span>
      <span class="uname">${name}</span>
    </div>
  `;
}

function logoutUser() {
  currentUser = null;
  document.getElementById('signupForm').style.display = 'block';
  document.getElementById('profileSection').style.display = 'none';
  document.getElementById('modalTitle').textContent = 'Create your Wander account';
  document.getElementById('authName').value = '';
  document.getElementById('authEmail').value = '';
  const container = document.getElementById('navUserContainer');
  container.innerHTML = `<button class="btn primary" onclick="openModal()" id="signupBtn">Sign Up</button>`;
