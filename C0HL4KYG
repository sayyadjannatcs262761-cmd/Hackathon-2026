window.addEventListener('click',e=>{if(e.target===$('authModal'))closeModal()});
function showToast(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.classList.remove('show'),3000)}

function renderDestinations(list=destinations){$('destinationGrid').innerHTML=list.map(d=>`<article class="destination-card"><div class="dest-img"><img src="${d.img}" alt="${d.name}" loading="lazy"><span class="tag">${d.country}</span></div><div class="dest-info"><h3>${d.name}</h3><div class="dest-location">${d.type.map(x=>x[0].toUpperCase()+x.slice(1)).join(' • ')}</div><p>${d.info}</p><div class="dest-bottom"><span class="price">From ₹${d.budget.toLocaleString('en-IN')}</span><button class="explore" onclick="showDestination('${d.name}')">Explore</button></div></div></article>`).join('')}
function showDestination(name){const d=destinations.find(x=>x.name===name);if(!d)return;$('planDestination').value=d.name;$('destinationDetail').innerHTML=`<img src="${d.img}" alt="${d.name}"><div><div class="eyebrow">${d.country}</div><h3>${d.name}</h3><p>${d.info}</p><p style="margin-top:8px"><b class="gold">Famous:</b> ${d.famous}</p><p style="margin-top:8px"><b class="gold">Typical trip budget:</b> ₹${d.budget.toLocaleString('en-IN')}+ per person</p><div class="detail-actions"><button class="btn primary" onclick="scrollToPlanner();showToast('Destination selected in AI Planner.')">✨ Plan with AI</button><button class="btn secondary" onclick="generateRoute('${d.name}')">🗺️ View route idea</button></div></div>`;$('destinationDetail').classList.add('active');$('destinationDetail').scrollIntoView({behavior:'smooth',block:'center'})}
async function performSearch(){
  const input=$('destinationSearch').value.trim();
  if(!input){renderDestinations(destinations);return}
  const q=input.toLowerCase();
  const local=destinations.filter(d=>(d.name+' '+d.country+' '+d.info+' '+d.famous).toLowerCase().includes(q));
  if(local.length){renderDestinations(local);return}
  showToast('Searching the world for '+input+'…');
  try{
    const res=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=6&addressdetails=1&q='+encodeURIComponent(input),{headers:{'Accept-Language':'en'}});
    const places=await res.json();
    if(!places.length){showToast('City not found. Try Tokyo, London, Paris, Dubai, New York, etc.');return}
    const worldwide=places.map((p,i)=>{const a=p.address||{};const city=a.city||a.town||a.village||a.municipality||p.name||input;const country=a.country||'';const state=a.state||'';return {name:city,country:country,type:['culture','food','nature'],info:state ? city+' · '+state+' · '+country : 'Explore '+city+', '+country+'.',famous:'Discover local landmarks, food, culture and experiences',budget:12000+i*1500,img:'https://images.unsplash.com/photo-1467269204594-9661b134dd2b?auto=format&fit=crop&w=900&q=80',lat:Number(p.lat),lon:Number(p.lon),worldwide:true}});
    worldwide.forEach(d=>{if(!destinations.some(x=>x.name.toLowerCase()===d.name.toLowerCase() && x.country.toLowerCase()===d.country.toLowerCase())){destinations.push(d)}});
    renderDestinations(worldwide);
    const d=worldwide[0];
    $('planDestination').value=d.name;
    $('destinationDetail').innerHTML=`<img src="${d.img}" alt="${d.name}"><div><div class="eyebrow">${d.country}</div><h3>${d.name}</h3><p>${d.info}</p><p style="margin-top:8px"><b class="gold">Location:</b> ${d.lat.toFixed(4)}, ${d.lon.toFixed(4)}</p><p style="margin-top:8px"><b class="gold">Typical trip budget:</b> ₹${d.budget.toLocaleString('en-IN')}+ per person</p><div class="detail-actions"><button class="btn primary" onclick="scrollToPlanner();showToast('Destination selected in AI Planner.')">✨ Plan with AI</button><button class="btn secondary" onclick="window.open('https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.name+', '+d.country)}','_blank')">🗺️ Open in Maps</button></div></div>`;
    $('destinationDetail').classList.add('active');
    $('destinationDetail').scrollIntoView({behavior:'smooth',block:'center'});
  }catch(err){console.error(err);showToast('World search is unavailable right now. Check your internet connection.')}
}
document.querySelectorAll('.category').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.category').forEach(b=>b.classList.remove('active'));btn.classList.add('active');const cat=btn.dataset.cat;renderDestinations(cat==='all'?destinations:destinations.filter(d=>d.type.includes(cat)))}));$('destinationSearch').addEventListener('keydown',e=>{if(e.key==='Enter')performSearch()});

function selectedInterests(){return [...document.querySelectorAll('.interest.active')].map(x=>x.dataset.interest)}
document.querySelectorAll('.interest').forEach(btn=>btn.addEventListener('click',()=>{btn.classList.toggle('active');if(!document.querySelector('.interest.active'))btn.classList.add('active')}));
function generateTrip(){const city=$('planDestination').value,days=Number($('days').value),travellers=Math.max(1,Number($('travelers').value)||1),budget=Math.max(2000,Number($('budget').value)||10000),style=$('style').value, interests=selectedInterests();const d=destinations.find(x=>x.name===city);const total=budget*travellers;const basePerDay=Math.round(total/days);const stay=Math.round(total*.34),transport=Math.round(total*.18),food=Math.round(total*.18),activities=total-stay-transport-food;const pool=plans[city]||['Explore the main landmark','Local food + neighborhood walk','Nature / culture experience','Free time + local shopping','Hidden gem + sunset'];let html=`<div class="trip-summary"><div class="summary-card"><div class="eyebrow">AI itinerary</div><h3>${city} · ${days} days · ${travellers} traveler${travellers>1?'s':''}</h3><p>${style} travel focused on ${interests.join(', ')||'mixed experiences'}. ${d?d.info:''}</p><div class="output-actions"><button class="btn primary" onclick="showToast('Trip saved locally for this demo.')">📌 Save Trip</button><button class="btn secondary" onclick="generateRoute('${city}')">🗺️ View Route</button><button class="btn secondary" onclick="showToast('Share link generated for the demo.')">↗ Share</button></div></div><div class="budget-card"><h3>Estimated budget</h3><div class="budget-number">₹${total.toLocaleString('en-IN')}</div><div class="budget-bar"><div class="budget-fill" id="budgetFill"></div></div><div class="budget-lines"><div class="budget-line"><span>🏨 Stay</span><b>₹${stay.toLocaleString('en-IN')}</b></div><div class="budget-line"><span>🚆 Transport</span><b>₹${transport.toLocaleString('en-IN')}</b></div><div class="budget-line"><span>🍜 Food</span><b>₹${food.toLocaleString('en-IN')}</b></div><div class="budget-line"><span>🎟️ Activities</span><b>₹${activities.toLocaleString('en-IN')}</b></div></div></div></div><div class="days">`;for(let i=1;i<=days;i++){const a=pool[(i-1)%pool.length],b=pool[i%pool.length],c=pool[(i+1)%pool.length];html+=`<div class="day-card"><div class="day-head"><strong>DAY ${i}</strong><span>₹${basePerDay.toLocaleString('en-IN')} target</span></div><div class="activity"><div class="time">09:00</div><div><b>${a}</b><p>Start with a practical sightseeing block and keep travel time low.</p></div></div><div class="activity"><div class="time">13:00</div><div><b>${b}</b><p>Choose a local meal and experience nearby rather than crossing the city.</p></div></div><div class="activity"><div class="time">18:00</div><div><b>${c}</b><p>Finish with a flexible evening activity matched to your interests.</p></div></div></div>`}html+='</div>';$('plannerOutput').innerHTML=html;$('plannerOutput').classList.add('active');requestAnimationFrame(()=>{const f=$('budgetFill');if(f)f.style.width='100%'});$('plannerOutput').scrollIntoView({behavior:'smooth',block:'center'})}
function generateRoute(city){const p=plans[city]||[];showToast(`Route idea: ${city} → ${p.slice(0,3).join(' → ')}`)}
$('plannerForm').addEventListener('submit',e=>{e.preventDefault();generateTrip()});

$('budgetSlider').addEventListener('input',()=>{$('budgetLabel').textContent='₹'+Number($('budgetSlider').value).toLocaleString('en-IN')});function optimizeBudget(){const b=Number($('budgetSlider').value);const save=Math.round(b*(b<15000?.12:.15));$('savingValue').textContent='₹'+save.toLocaleString('en-IN');$('staySave').textContent='₹'+Math.round(save*.5).toLocaleString('en-IN');$('transportSave').textContent='₹'+Math.round(save*.3).toLocaleString('en-IN');$('foodSave').textContent='₹'+Math.round(save*.2).toLocaleString('en-IN');showToast('Budget optimized — smarter choices applied.')}

function toggleChat(){$('aiChat').classList.toggle('active')}
function addMessage(text,type){const el=document.createElement('div');el.className='message '+type;el.textContent=text;$('aiMessages').appendChild(el);$('aiMessages').scrollTop=$('aiMessages').scrollHeight}
function quickChat(text){$('aiInput').value=text;$('chatForm').dispatchEvent(new Event('submit',{cancelable:true,bubbles:true}))}
function aiReply(text){const q=text.toLowerCase();const d=destinations.find(x=>q.includes(x.name.toLowerCase()));if(q.includes('plan')&&d){$('planDestination').value=d.name;scrollToPlanner();return `Absolutely! I selected ${d.name} in the AI Trip Planner. Choose your days and budget, then generate the itinerary.`}if(d)return `${d.name} is great for ${d.type.join(', ')}. Highlights include ${d.famous}. A typical starting budget is about ₹${d.budget.toLocaleString('en-IN')} per person.`;if(q.includes('budget')||q.includes('cheap')||q.includes('save'))return 'Use public transport, stay slightly outside premium areas, group nearby attractions and choose local food. The Smart Budget Optimizer below can show a sample saving.';if(q.includes('food'))return 'Try regional specialties, local markets and neighborhood food walks. Wander can also place food stops between nearby attractions.';if(q.includes('route'))return 'Open any destination and choose “View route idea”, or generate a full itinerary in the AI Trip Planner.';if(q.includes('hello')||q.includes('hi'))return 'Hey traveler! 👋 Tell me a destination or ask me to plan a trip.';return 'I can help with destinations, budgets, food, routes and trip planning. Try: “Plan a 3 day Goa trip” or “Tell me about Jaipur”.'}
$('chatForm').addEventListener('submit',e=>{e.preventDefault();const v=$('aiInput').value.trim();if(!v)return;addMessage(v,'user');$('aiInput').value='';setTimeout(()=>addMessage(aiReply(v),'bot'),350)});

let scene,camera,renderer,globe;function initGlobe(){const c=$('globe-container');if(!c||typeof THREE==='undefined')return;const w=c.clientWidth,h=c.clientHeight;scene=new THREE.Scene();camera=new THREE.PerspectiveCamera(45,w/h,.1,100);camera.position.z=3.1;renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(w,h);c.appendChild(renderer.domElement);scene.add(new THREE.AmbientLight(0xffffff,1.5));const light=new THREE.DirectionalLight(0xffffff,2);light.position.set(4,3,5);scene.add(light);const geo=new THREE.SphereGeometry(1,64,64);const tex=new THREE.TextureLoader();const mat=new THREE.MeshPhongMaterial({map:tex.load('https://threejs.org/examples/textures/land_ocean_ice_cloud_2048.jpg'),shininess:7});globe=new THREE.Mesh(geo,mat);scene.add(globe);function loop(){requestAnimationFrame(loop);if(globe)globe.rotation.y+=.002;renderer.render(scene,camera)}loop();window.addEventListener('resize',()=>{const w2=c.clientWidth,h2=c.clientHeight;if(w2&&h2){camera.aspect=w2/h2;camera.updateProjectionMatrix();renderer.setSize(w2,h2)}})}
window.addEventListener('load',()=>{initGlobe();renderDestinations();const today=new Date();$('startDate').value=today.toISOString().slice(0,10)});
</script>
