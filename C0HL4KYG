<script>
const destinations=[
{name:'Mumbai',country:'India',type:['culture','food'],info:'Fast-paced coastal city with heritage, street food and iconic neighborhoods.',famous:'Gateway of India, Marine Drive, Colaba, Elephanta',budget:9000,img:'https://images.unsplash.com/photo-1570168007204-dfb528c6958f?auto=format&fit=crop&w=900&q=80'},
{name:'Goa',country:'India',type:['beach','food','adventure'],info:'A relaxed coastal escape combining beaches, local food, nightlife and nature.',famous:'Baga, Palolem, Panjim, Fort Aguada',budget:11000,img:'https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=900&q=80'},
{name:'Jaipur',country:'India',type:['culture','food','shopping'],info:'The Pink City is packed with forts, palaces, crafts and Rajasthani cuisine.',famous:'Amber Fort, City Palace, Hawa Mahal, Johari Bazaar',budget:10000,img:'https://images.unsplash.com/photo-1477587458883-47145ed94245?auto=format&fit=crop&w=900&q=80'},
{name:'Delhi',country:'India',type:['culture','food','shopping'],info:'A historic capital where Mughal landmarks, markets and modern India meet.',famous:'Red Fort, India Gate, Humayun’s Tomb, Chandni Chowk',budget:8500,img:'https://images.unsplash.com/photo-1587474260584-136574528ed5?auto=format&fit=crop&w=900&q=80'},
