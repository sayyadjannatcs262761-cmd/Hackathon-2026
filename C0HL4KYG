<body>
<header class="navbar">
  <div class="nav-inner">
    <a class="logo" href="#home"><span class="logo-mark">✦</span>Wander</a>
    <nav class="nav-links" id="navLinks">
      <a href="#planner">AI Planner</a><a href="#explore">Explore</a><a href="#local">Local Tourism</a><a href="#budget">Smart Budget</a>
      <span id="navUserContainer">
        <button class="btn primary" onclick="openModal()" id="signupBtn">Sign Up</button>
      </span>
    </nav>
    <button class="menu-btn" onclick="toggleMenu()">☰</button>
  </div>
</header>

<main id="home">
<section class="hero">
 <div class="container hero-grid">
  <div>
   <span class="badge">✦ AI-powered smart tourism</span>
   <h1>Travel smarter.<br><span>Wander better.</span></h1>
   <p>Build a personalized journey from your destination, budget, interests and travel style — then discover local stays, food and experiences along the way.</p>
   <div class="hero-actions"><button class="btn primary" onclick="scrollToPlanner()">✨ Plan My Trip</button><button class="btn secondary" onclick="document.getElementById('explore').scrollIntoView({behavior:'smooth'})">Explore Destinations</button></div>
   <div class="hero-stats"><div class="stat"><strong>AI</strong><small>Trip planning</small></div><div class="stat"><strong>₹</strong><small>Budget optimized</small></div><div class="stat"><strong>Local</strong><small>Tourism focused</small></div></div>
  </div>
  <div class="globe-wrap"><div class="globe-card"><div id="globe-container"></div></div><div class="floating-pill pill-one">🌍 100+ travel ideas</div><div class="floating-pill pill-two">💰 Smart budget</div><div class="floating-pill pill-three">● Local-first travel</div></div>
 </div>
</section>

<section id="planner" class="planner-section">
 <div class="container">
  <div class="section-head"><div class="eyebrow">Your hero feature</div><h2>AI Trip Planner</h2><p>Tell Wander what you want. The planner turns your preferences into a practical day-by-day itinerary and estimated budget.</p></div>
  <div class="planner-shell glass">
   <div class="planner-top"><div><h2>Plan your perfect journey</h2><p>Frontend demo — no API key required.</p></div><span class="ai-chip">● Smart planner ready</span></div>
   <form id="plannerForm" class="planner-form">
    <div class="field"><label>Destination</label><select id="planDestination"><option value="Mumbai">Mumbai</option><option value="Goa">Goa</option><option value="Jaipur">Jaipur</option><option value="Delhi">Delhi</option><option value="Kerala">Kerala</option><option value="Manali">Manali</option><option value="Dubai">Dubai</option><option value="Paris">Paris</option></select></div>
    <div class="field"><label>Start date</label><input id="startDate" type="date"></div>
    <div class="field"><label>Days</label><select id="days"><option value="2">2 days</option><option value="3" selected>3 days</option><option value="4">4 days</option><option value="5">5 days</option><option value="7">7 days</option></select></div>
    <div class="field"><label>Travelers</label><input id="travelers" type="number" min="1" max="12" value="2"></div>
    <div class="field"><label>Budget per person (₹)</label><input id="budget" type="number" min="2000" step="500" value="15000"></div>
    <div class="field"><label>Travel style</label><select id="style"><option>Balanced</option><option>Budget</option><option>Comfort</option><option>Adventure</option></select></div>
    <div class="field full"><label>Interests</label><div class="interest-list" id="interestList"><button type="button" class="interest active" data-interest="culture">🏛️ Culture</button><button type="button" class="interest" data-interest="food">🍜 Food</button><button type="button" class="interest" data-interest="nature">🌿 Nature</button><button type="button" class="interest" data-interest="beach">🏖️ Beaches</button><button type="button" class="interest" data-interest="adventure">🥾 Adventure</button><button type="button" class="interest" data-interest="shopping">🛍️ Shopping</button></div></div>
   </form>
   <div class="planner-actions"><button class="btn primary" onclick="generateTrip()">✨ Generate My Trip</button></div>
   <div class="planner-output" id="plannerOutput"></div>
  </div>
 </div>
</section>

<section id="explore" class="search-area">
 <div class="container">
  <div class="section-head"><div class="eyebrow">Discover</div><h2>Explore destinations</h2><p>Search a city or filter by travel mood. Open a destination to send it directly into the AI planner.</p></div>
  <div class="search-box"><input id="destinationSearch" placeholder="Search Mumbai, Goa, Paris, Jaipur..." autocomplete="off"><button onclick="performSearch()">Search</button></div>
  <div class="category-row"><button class="category active" data-cat="all">All</button><button class="category" data-cat="beach">🏖️ Beach</button><button class="category" data-cat="culture">🏛️ Culture</button><button class="category" data-cat="nature">🌿 Nature</button><button class="category" data-cat="food">🍜 Food</button><button class="category" data-cat="adventure">🥾 Adventure</button></div>
  <div id="destinationGrid" class="destination-grid"></div>
  <div id="destinationDetail" class="detail"></div>
 </div>
</section>

<section id="local">
 <div class="container"><div class="section-head"><div class="eyebrow">Spend local</div><h2>More than hotels & flights</h2><p>Wander connects travelers with the people and businesses that make a destination worth visiting.</p></div>
  <div class="local-grid"><div class="local-card"><div class="local-icon">🏡</div><h3>Homestays</h3><p>Discover authentic stays and neighborhood experiences instead of only large chains.</p><button onclick="showToast('Local homestay discovery added to the trip.')">Add to trip →</button></div><div class="local-card"><div class="local-icon">🍲</div><h3>Local food</h3><p>Find regional dishes, street food ideas and food experiences around your route.</p><button onclick="showToast('Local food stops added to your plan.')">Add to trip →</button></div><div class="local-card"><div class="local-icon">🧭</div><h3>Experiences</h3><p>Build meaningful activities around culture, nature, adventure and community.</p><button onclick="showToast('Local experiences added to your plan.')">Add to trip →</button></div><div class="local-card"><div class="local-icon">🎨</div><h3>Artisans & shops</h3><p>Support local makers and discover souvenirs with a story behind them.</p><button onclick="showToast('Local shopping stop added to your plan.')">Add to trip →</button></div></div>
 </div>
