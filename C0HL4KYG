function openModal(){ $('authModal').classList.add('active'); }
function closeModal(){ $('authModal').classList.remove('active'); }

let currentUser = null;

function submitAuth() {
  const name = document.getElementById('authName').value.trim();
  const email = document.getElementById('authEmail').value.trim();
  if (!name || !email) {
    showToast('Please enter your name and email.');
    return;
  }
  currentUser = { name, email };
  showProfile(name, email);
  showToast('🎉 Welcome, ' + name + '! Your Wander profile is ready.');
  document.getElementById('formMessage').style.display = 'block';
  document.getElementById('formMessage').textContent = '🎉 Welcome, ' + name + '! Your Wander profile is ready.';
  setTimeout(() => {
    document.getElementById('formMessage').style.display = 'none';
  }, 2500);
  updateNavbar(name);
}

function showProfile(name, email) {
  document.getElementById('signupForm').style.display = 'none';
  document.getElementById('profileSection').style.display = 'block';
  document.getElementById('modalTitle').textContent = '👤 Your Profile';
  document.getElementById('profileAvatar').textContent = name.charAt(0).toUpperCase();
