{name:'Dubai',country:'UAE',type:['shopping','adventure','food'],info:'Modern skyline, desert adventures, shopping and global cuisine.',famous:'Burj Khalifa, Dubai Marina, Old Dubai, Desert Safari',budget:38000,img:'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=900&q=80'},
